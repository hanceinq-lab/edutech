# ── REQUIRED ──────────────────────────────────────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/eduflow

# JWT secret — change this to any long random string
JWT_SECRET=eduflow_super_secret_jwt_key_change_me_in_production_2024
JWT_EXPIRE=30d

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── OPTIONAL: AWS S3 (only needed for direct S3 video uploads) ─────────────
# Leave these blank — lessons work fine with YouTube/Vimeo URLs without S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=

# ── OPTIONAL: Stripe (only needed for paid course checkout) ───────────────
# Leave blank to disable payments. Free course enrollment always works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
